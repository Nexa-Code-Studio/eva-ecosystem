# Local Development Dockerfile for eva_emotion_service.
# Supports BOTH pinned ONNX INT8 models (when mounted in /models) AND automatic local
# FunASR `iic/emotion2vec_plus_base` inference (CPU-only PyTorch) so `make dev` works
# out-of-the-box without bloating the production Cloud Run `Dockerfile`.
FROM python:3.11-slim

WORKDIR /service

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=180 \
    PORT=8890 \
    ORT_INTRA_OP_THREADS=2 \
    ORT_INTER_OP_THREADS=1 \
    EMOTION_ENGINE_BACKEND=auto \
    EMOTION_MODEL_PATH=/models/emotion2vec_plus_base_int8.onnx

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY apps/backend/emotion_service/pyproject.toml /service/pyproject.toml
COPY apps/backend/emotion_service/app /service/app

RUN pip install --no-cache-dir . \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchaudio \
    && pip install --no-cache-dir funasr modelscope soundfile

RUN useradd --create-home --shell /bin/bash appuser \
    && mkdir -p /models /home/appuser/.cache \
    && chown -R appuser:appuser /service /models /home/appuser/.cache

USER appuser

EXPOSE 8890

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8890} --workers 1"]
