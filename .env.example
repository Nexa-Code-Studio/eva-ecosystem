# Application Environment & URLs
APP_ENV=development
LOG_LEVEL=INFO
PORT=8888
MCP_PORT=8889
API_BASE_URL=http://localhost:8888/api/v1
WS_BASE_URL=ws://localhost:8888
# Production:
# API_BASE_URL=https://eva.nexacode.dev/api/v1
# WS_BASE_URL=wss://eva.nexacode.dev


# Infrastructure Connections (Local development default; use docker service names like @eva_postgres:5432 when running inside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/eva_ai
POSTGRES_DB=eva_ai
REDIS_URL=redis://localhost:6380/0

# WebRTC Signaling & Cloudflare Calls TURN
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL_SECONDS=14400
WEBRTC_STUN_URLS=["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302","stun:stun.cloudflare.com:3478"]
WEBRTC_RECONNECT_GRACE_SECONDS=25
QDRANT_URL=http://localhost:6333

# AI Providers Configuration (Placeholders)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
LLM_API_KEY=your-llm-api-key-here


# Realtime STT Settings (elevenlabs) — reuses ELEVENLABS_API_KEYS unless ELEVENLABS_STT_API_KEY is set
STT_PROVIDER=elevenlabs
ELEVENLABS_STT_API_KEY=
ELEVENLABS_STT_URL=wss://api.elevenlabs.io/v1/speech-to-text/realtime
ELEVENLABS_STT_MODEL_ID=scribe_v2_realtime
ELEVENLABS_STT_LANGUAGE_CODE=id
ELEVENLABS_STT_COMMIT_STRATEGY=vad
ELEVENLABS_STT_VAD_SILENCE_THRESHOLD_SECS=0.8
ELEVENLABS_STT_VAD_THRESHOLD=0.4
STT_IDLE_CLOSE_TIMEOUT_S=15.0
STT_ALLOW_INCOGNITO_CLOUD_AUDIO=false

TTS_PROVIDER=elevenlabs
TTS_API_KEY=your-tts-api-key-here
ELEVENLABS_API_KEYS=your-tts-key-1,your-tts-key-2
EDGE_TTS_VOICE=id-ID-GadisNeural

# Midtrans Payment (Core API QRIS) & Payout (Iris / BI-SNAP)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_SIGNATURE_SECRET_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_QRIS_ACQUIRER=gopay
MIDTRANS_PAYMENT_ENABLED=false
MIDTRANS_SANDBOX_SIMULATION_ENABLED=true
MIDTRANS_BISNAP_CLIENT_ID=
MIDTRANS_BISNAP_CLIENT_SECRET=
MIDTRANS_BISNAP_PRIVATE_KEY_PATH=
MIDTRANS_BISNAP_PARTNER_ID=
MIDTRANS_BISNAP_CHANNEL_ID=
MIDTRANS_PAYOUT_ENABLED=false
MIDTRANS_PAYOUT_PROVIDER_MODE=iris
MIDTRANS_IRIS_BASE_URL=
MIDTRANS_IRIS_CREATOR_KEY=
MIDTRANS_IRIS_APPROVER_KEY=
MIDTRANS_IRIS_NOTIFICATION_SECRET=
MIDTRANS_PAYOUT_AUTO_APPROVE=false
BANK_ACCOUNT_ENCRYPTION_KEY=

# Continuous 3-Second Speech Emotion Orchestration (Issue #143 — default OFF)
EMOTION_STREAMING_ENABLED=false
EMOTION_PROVIDER=remote_http
EMOTION_SERVICE_URL=http://emotion_service:8890
EMOTION_SERVICE_AUTH_MODE=none
EMOTION_SERVICE_AUDIENCE=
EMOTION_SERVICE_BEARER_TOKEN=
EMOTION_SERVICE_TIMEOUT_MS=2000
EMOTION_SEGMENT_DURATION_MS=3000
EMOTION_MIN_TAIL_DURATION_MS=750
EMOTION_WINDOW_TARGET_MS=30000
EMOTION_WINDOW_STALENESS_MS=180000
EMOTION_WINDOW_MIN_COVERAGE=0.60
EMOTION_DISPATCHER_MAX_INFLIGHT=32
EMOTION_DISPATCHER_PER_SESSION_MAX_INFLIGHT=4
EMOTION_DISPATCHER_QUEUE_SIZE=128
EMOTION_SEGMENT_DEADLINE_MS=4000
EMOTION_FINALIZE_DRAIN_MS=1500
EMOTION_ALLOW_INCOGNITO_CLOUD_AUDIO=false


